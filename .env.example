# Optional: sync progress to a private GitHub Gist so it follows you across browsers and machines.
# Copy this file to .env.local (gitignored) and fill it in, then restart `npm run dev`.
#
# Token: a classic personal access token with ONLY the "gist" scope
#   https://github.com/settings/tokens/new?scopes=gist&description=The%20AI%20Engineer
#
# Vite inlines these values into the JavaScript it serves. Run the app locally and never
# publish a build that was made with a token in it.
VITE_GITHUB_TOKEN=

# Leave empty on first run and click "Create private gist" on the Progress file page,
# then paste the id it shows here. Or use the id of an existing gist you own.
VITE_GIST_ID=

# File name inside the gist (optional).
VITE_GIST_FILENAME=progress.json
